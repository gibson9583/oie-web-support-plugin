<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openintegrationengine.plugins</groupId>
    <artifactId>websupport</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>

    <name>OIE Web Support</name>
    <description>Engine-side REST endpoints backing the OIE web administrator: data type serialization, JavaScript validation, and web plugin asset serving. No engine changes, no UI.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Point at an OIE installation (or a built engine tree) that provides the engine jars. -->
        <oie.home>${env.OIE_HOME}</oie.home>
    </properties>

    <dependencies>
        <!-- Engine jars: provided by the running engine, sourced from an install for compilation. -->
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-server</artifactId>
            <version>4.6.0</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/mirth-server.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-client-core</artifactId>
            <version>4.6.0</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/mirth-client-core.jar</systemPath>
        </dependency>
        <!-- SerializationType (IMessageSerializer's serialization mode) lives in donkey-model. -->
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>donkey-model</artifactId>
            <version>4.6.0</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/donkey/donkey-model.jar</systemPath>
        </dependency>

        <!-- APIs present on the engine classpath at runtime; compile against Central copies. -->
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.14.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.15</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging. Provided: the engine ships log4j2 on its own classpath. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.23.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>websupport-shared</finalName>
        <plugins>
            <!-- Second jar carrying only the WAR-deploy service plugin. The OIE Web
                 Client extension can be installed without Web Support, so it must
                 ship this class itself rather than rely on the shared library. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>webclient-deploy-jar</id>
                        <phase>prepare-package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>webclient-deploy</classifier>
                            <includes>
                                <include>org/openintegrationengine/plugins/websupport/WebClientDeployServicePlugin.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Assemble the installable extension zip: websupport/{plugin.xml, jar}. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/main/assembly/extension-zip.xml</descriptor>
                    </descriptors>
                    <finalName>websupport-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>extension-zip</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <!-- Supplying -Dwebclient.war=/path/to/oie-web-client.war adds a second,
         bundled extension ZIP while retaining the normal API-only artifact. -->
    <profiles>
        <profile>
            <id>web-client-bundle</id>
            <activation>
                <property>
                    <name>webclient.war</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>extension-zip-with-web-client</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <descriptors combine.self="override">
                                        <descriptor>src/main/assembly/extension-zip-web-client.xml</descriptor>
                                    </descriptors>
                                    <finalName>websupport-web-client-${project.version}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <attach>false</attach>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
