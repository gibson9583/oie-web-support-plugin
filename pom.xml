<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openintegrationengine.plugins</groupId>
    <artifactId>websupport</artifactId>
    <version>1.0.3</version>
    <packaging>jar</packaging>

    <name>OIE Web Support</name>
    <description>OIE web administrator bundle: the embedded browser client plus its engine-side REST endpoints.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- GitHub Release version of oie-webadmin.war bundled by release.yml.
             Keep this equal to the plugin version when the release lines match;
             set it independently when the web client and plugin diverge. -->
        <webclient.version>0.9.0</webclient.version>
        <!-- Point at an OIE installation (or a built engine tree) that provides the engine jars. -->
        <oie.home>${env.OIE_HOME}</oie.home>
        <!-- Jar signing is off by default; the signing profile enables it. -->
        <signing.skip>true</signing.skip>
    </properties>

    <profiles>
        <!-- Signs websupport-shared.jar with a YubiKey-held code-signing certificate
             via PKCS#11. The WAR is deliberately left unsigned: release.yml verifies
             it byte-identical to the web client's published release asset. -->
        <profile>
            <id>signing</id>
            <properties>
                <signing.skip>false</signing.skip>
                <signing.keystore>NONE</signing.keystore>
                <signing.storetype>PKCS11</signing.storetype>
                <signing.providerClass>sun.security.pkcs11.SunPKCS11</signing.providerClass>
                <signing.providerArg>${user.dir}/yubikey-pkcs11.cfg</signing.providerArg>
                <signing.alias>Certificate for PIV Authentication</signing.alias>
                <signing.storepass>${env.YUBIKEY_PIN}</signing.storepass>
                <signing.certchain>${user.dir}/certchain.pem</signing.certchain>
                <signing.tsa>http://timestamp.digicert.com</signing.tsa>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- Engine jars: provided by the running engine, sourced from an install for compilation. -->
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-server</artifactId>
            <version>4.5.2</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/mirth-server.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-client-core</artifactId>
            <version>4.5.2</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/mirth-client-core.jar</systemPath>
        </dependency>
        <!-- SerializationType (IMessageSerializer's serialization mode) lives in donkey-model. -->
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>donkey-model</artifactId>
            <version>4.5.2</version>
            <scope>system</scope>
            <systemPath>${oie.home}/server-lib/donkey/donkey-model.jar</systemPath>
        </dependency>

        <!-- APIs present on the engine classpath at runtime; compile against Central copies. -->
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.14.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.15</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging. Provided: the engine ships log4j2 on its own classpath. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.23.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>websupport-shared</finalName>
        <plugins>
            <!-- Sign websupport-shared.jar before the assembly zips it. Declared ahead
                 of the assembly plugin so it runs first within the package phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <id>sign</id>
                        <phase>package</phase>
                        <goals><goal>sign</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${signing.skip}</skip>
                    <keystore>${signing.keystore}</keystore>
                    <storetype>${signing.storetype}</storetype>
                    <providerClass>${signing.providerClass}</providerClass>
                    <providerArg>${signing.providerArg}</providerArg>
                    <alias>${signing.alias}</alias>
                    <storepass>${signing.storepass}</storepass>
                    <tsa>${signing.tsa}</tsa>
                    <arguments>
                        <argument>-certchain</argument>
                        <argument>${signing.certchain}</argument>
                    </arguments>
                </configuration>
            </plugin>
            <!-- Assemble one installable extension containing the APIs and WAR. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/main/assembly/extension-zip.xml</descriptor>
                    </descriptors>
                    <finalName>websupport-${project.version}-oie4.5.2</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>extension-zip</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>
