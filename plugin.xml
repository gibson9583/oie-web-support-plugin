<pluginMetaData path="websupport">
	<name>Web Support</name>
	<author>Chris Gibson</author>
	<pluginVersion>1.0.1</pluginVersion>
	<mirthVersion>4.5.2</mirthVersion>
	<url>https://openintegrationengine.org</url>
	<description>Installs the embedded OIE web administrator and its supporting REST endpoints: byte-exact message serialization, server-side JavaScript validation, and installed extensions' web UIs.</description>
	<serverClasses>
		<string>org.openintegrationengine.plugins.websupport.WebSupportServicePlugin</string>
		<string>org.openintegrationengine.plugins.websupport.WebClientDeployServicePlugin</string>
	</serverClasses>
	<library type="SHARED" path="websupport-shared.jar" />
	<apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.websupport.WebSupportServletInterface"/>
	<apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.websupport.WebSupportServlet"/>
</pluginMetaData>
